{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Read(**/deploy/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/wg*.conf)",
      "Read(**/.npmrc)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push -uf*)",
      "Bash(git push * -uf*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git * push -f*)",
      "Bash(git * push * -f*)",
      "Bash(git * push --force*)",
      "Bash(git * push * --force*)",
      "Bash(git * push +*)",
      "Bash(git * push * +*)",
      "Bash(git * push *--mirror*)",
      "Bash(git * push *--delete*)",
      "Bash(git send-pack*)",
      "Bash(git * send-pack*)",
      "Bash(git * --output*)",
      "Bash(git * --no-index*)",
      "Bash(git grep * -O*)",
      "Bash(git grep * --open-files-in-pager*)",
      "Bash(pnpm dlx*)",
      "Bash(pnpm exec*)",
      "Bash(pnpm * dlx*)",
      "Bash(pnpm * exec*)",
      "Bash(pnpx*)",
      "Bash(npx*)"
    ],
    "allow": [
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm check)",
      "Bash(pnpm test)",
      "Bash(pnpm test:integration)",
      "Bash(pnpm build)",
      "Bash(pnpm i18n)",
      "Bash(pnpm check:bom)",
      "Bash(pnpm check:boundaries)",
      "Bash(pnpm -F web build)",
      "Bash(pnpm -F web i18n)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git rev-parse *)",
      "Bash(git cat-file *)",
      "Bash(git blame *)",
      "Bash(git branch --list*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
