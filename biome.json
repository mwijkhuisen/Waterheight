{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!docs/plan",
      "!docs/sources",
      "!scripts/fixtures/boundaries",
      "!apps/server/src/db/generated.ts",
      "!**/*.golden.json",
      "!packages/contracts/openapi*.json",
      "!apps/web/public/assets/map",
      "!apps/web/src/features/map/styles",
      "!tools/geo/fixtures/*.metadata.json",
      "!tools/geo/fixtures/rivernet.*",
      "!tools/geo/fixtures/euhydro",
      "!tools/geo/fixtures/wikidata",
      "!tools/geo/fixtures/geofabrik",
      "!test/fixtures/reaches-fixture.json"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": { "rules": { "preset": "recommended" } }
}
