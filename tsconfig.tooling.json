{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "lib": ["es2024", "esnext.temporal"],
    "types": ["node"],
    "tsBuildInfoFile": "node_modules/.cache/tsc/tooling.tsbuildinfo"
  },
  "include": [
    "vitest.config.ts",
    "scripts/*.ts",
    "test/**/*.ts",
    "apps/*/test/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/web/vite.config.ts",
    "apps/web/i18n-html.ts",
    "apps/web/notices.ts",
    "apps/web/src/features/map/protocol.ts",
    "apps/web/src/features/map/resolveStyle.ts",
    "apps/web/src/features/map/stationLayer.ts",
    "apps/web/src/features/map/icons.ts",
    "apps/web/src/features/map/rivers.ts",
    "apps/web/src/features/map/warnings.ts",
    "apps/web/src/features/map/popup.ts",
    "apps/web/src/features/station/forecast.ts",
    "apps/web/src/features/station/value.ts",
    "apps/web/src/features/station/state.ts",
    "apps/web/src/features/station/chartModel.ts",
    "apps/web/src/features/station/provenance.ts",
    "apps/web/src/lib/attribution.ts",
    "apps/web/src/lib/config/runtime.ts",
    "apps/web/src/features/legend/palette.ts",
    "apps/web/src/features/legend/items.ts",
    "apps/web/src/features/owner/href.ts",
    "apps/web/src/features/table/page.ts",
    "apps/web/src/features/owner/contracts.ts",
    "apps/web/src/lib/data/*.ts",
    "apps/web/src/lib/labels/*.ts",
    "apps/web/src/features/owner/labels.gen.ts",
    "apps/web/src/lib/stationStates.ts",
    "apps/web/src/lib/forecast.ts",
    "apps/web/src/lib/time/time.ts",
    "apps/web/src/lib/url/url.ts",
    "tools/**/*.ts"
  ],
  "references": [{ "path": "packages/contracts" }, { "path": "packages/core" }, { "path": "apps/server" }]
}
