{
  "name": "@rws/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/cli/migrate.ts",
    "refresh": "tsx src/cli/refresh.ts",
    "test": "vitest run",
    "pretest": "npm run build --workspace @rws/shared"
  },
  "dependencies": {
    "@rws/shared": "*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
