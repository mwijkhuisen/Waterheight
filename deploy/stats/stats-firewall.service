# The stats host firewall (#270, ADR-0024): deploy/stats/nftables-stats.conf, installed as
# /etc/stats/nftables-stats.conf. It only ever touches table inet stats, and stopping it keeps the table (no
# ExecStop), as rws-firewall does. docker.service does not require it: a failed stats firewall must never stop the
# rws stack. The price is that the stats containers start unfiltered if this unit fails at boot (risk register R-116);
# docs/runbooks/stats.md checks the table after every boot and change.
[Unit]
Description=stats host firewall (nftables table inet stats)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target docker.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -c -f /etc/stats/nftables-stats.conf
ExecStart=/usr/sbin/nft -f /etc/stats/nftables-stats.conf
# No resolver yet is no reason to fail the firewall: stats-resolvers.path fills the set when resolv.conf is written.
ExecStartPost=-/usr/local/bin/stats-resolvers
ExecReload=/usr/sbin/nft -c -f /etc/stats/nftables-stats.conf
ExecReload=/usr/sbin/nft -f /etc/stats/nftables-stats.conf
# The reload recreates the table, which empties resolvers4: a failed refill fails the reload (review CR-8).
ExecReload=/usr/local/bin/stats-resolvers

[Install]
WantedBy=sysinit.target
