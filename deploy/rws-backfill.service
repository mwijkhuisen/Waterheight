# One-off historical backfill: `systemctl start rws-backfill`.
#
# A full year takes roughly 2.5 hours for the eager tier, which is longer than
# an SSH session should be trusted to last. Running it as a unit means it
# survives a disconnect, logs to the journal and can be stopped cleanly.
#
# The queue is resumable -- a chunk is marked done in the same transaction that
# writes its rows -- so stopping and starting this unit continues where it left
# off rather than restarting the download.

[Unit]
Description=RWS monitoring map historical backfill
Documentation=https://github.com/mwijkhuisen/rws
Wants=postgresql.service
After=network-online.target postgresql.service rws-api.service

[Service]
Type=oneshot
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@REPO_DIR@

Environment=NODE_ENV=production
Environment=ENV_FILE=@REPO_DIR@/.env

ExecStart=@NODE@ packages/server/dist/cli/backfill.js

# Hours, not minutes. 0 disables the timeout entirely.
TimeoutStartSec=0
# SIGINT is what the CLI listens for to drain in-flight chunks and exit cleanly.
KillSignal=SIGINT
TimeoutStopSec=5m

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rws-backfill

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# read-only rather than true when the install lives under /home:
# ProtectHome=true makes /home appear EMPTY to the service, so a repo
# there is invisible and even WorkingDirectory cannot be entered.
ProtectHome=@PROTECT_HOME@

[Install]
WantedBy=multi-user.target
