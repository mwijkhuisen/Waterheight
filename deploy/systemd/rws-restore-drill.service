# monthly restore drill of 100 raw objects (issue #16 P1b). Runs as root: it drives docker and reads /etc/rws/secrets.
[Unit]
Description=rws: monthly restore drill of 100 raw objects
Wants=network-online.target
After=network-online.target docker.service rws-firewall.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/rws-restore-drill
TimeoutStartSec=2h
UMask=0077
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full
NoNewPrivileges=yes
