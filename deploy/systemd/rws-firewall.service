# The host firewall (deploy/host/nftables.conf, installed as /etc/rws/nftables.conf).
# Replaces Debian's nftables.service, whose ExecStop flushes the whole ruleset
# (Docker's tables included); this unit only ever touches table inet rws.
[Unit]
Description=rws host firewall (nftables table inet rws)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target docker.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -c -f /etc/rws/nftables.conf
ExecStart=/usr/sbin/nft -f /etc/rws/nftables.conf
# No resolver yet is no reason to fail the firewall (docker.service Requires= it).
ExecStartPost=-/usr/local/bin/rws-resolvers
ExecReload=/usr/sbin/nft -f /etc/rws/nftables.conf
ExecReload=-/usr/local/bin/rws-resolvers
ExecStop=/usr/sbin/nft delete table inet rws

[Install]
WantedBy=sysinit.target
