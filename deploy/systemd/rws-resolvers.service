# Loads the host's DNS resolvers into the sets the container egress rules allow DNS to.
# Also runs once at boot once the network is up: the firewall's own run at
# sysinit may find no resolver yet (rws-tick is the backstop).
[Unit]
Description=rws: container DNS allowlist from resolv.conf
Wants=network-online.target
After=rws-firewall.service network-online.target systemd-resolved.service
Requisite=rws-firewall.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/rws-resolvers

[Install]
WantedBy=multi-user.target
