# disk % into ops.json, restart unhealthy containers (issue #16 P1b). Runs as root: it drives docker and reads /etc/rws/secrets.
[Unit]
Description=rws: disk % into ops.json, restart unhealthy containers
Wants=network-online.target
After=network-online.target docker.service rws-firewall.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/rws-tick
TimeoutStartSec=5min
UMask=0077
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full
NoNewPrivileges=yes
