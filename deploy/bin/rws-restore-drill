#!/usr/bin/env bash
# rws-restore-drill (rws-restore-drill.timer, monthly; A§11.3; issue #16 P1b).
# Restores a random sample of 100 raw objects from the latest snapshot into a
# scratch directory and checks that sha256(zstd -dc object) equals the sha256 in
# the manifest line that recorded it. Only lines older than the snapshot (minus
# 10 min) are sampled, so an object written during the backup cannot count as
# missing. The result goes to /status/ops.json as counts only
# (drill {at, sampled, matched}); the scratch directory, which may hold
# owner-audience payloads, never leaves the VPS and is always emptied.
#
# Usage: rws-restore-drill [--force | --dry-run]
#   --force    run now even if a drill ran in the last 25 days (owner, A§11.3)
#   --dry-run  report what would run
set -euo pipefail
# shellcheck source=deploy/bin/rws-lib.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/rws-lib.sh"

readonly SAMPLE=100
readonly KEY_RE='^raw/[A-Z]{2}-[0-9]{1,2}/[a-z0-9]+(-[a-z0-9]+)*/[0-9]{4}/[0-9]{2}/[0-9]{2}/[0-9]{6}Z-[0-9a-f]{16}\.zst$'
force=0
case ${1:-} in
  --force) force=1 ;;
  --dry-run) DRY_RUN=1 ;;
  '') ;;
  *)
    echo "usage: rws-restore-drill [--force | --dry-run]" >&2
    exit 64
    ;;
esac

if ! backup_ready; then
  log "backups are off (RWS_BACKUP): no drill"
  exit 0
fi
[[ -e $RWS_STATE_DIR/active ]] || die "no release is deployed yet"

ops=$RWS_SRV/public/ops/ops.json
last=$(jq -r '.drill.at // empty' "$ops" 2>/dev/null || true)
if ((!force)) && [[ -n $last ]] && (($(date -u +%s) - $(date -u -d "$last" +%s) < 25 * 86400)); then
  log "the last drill ran at $last: next one due later (--force runs it now)"
  exit 0
fi
if ((DRY_RUN)); then
  log "dry-run: would restore $SAMPLE objects from the latest snapshot at $BUCKET_HOST"
  exit 0
fi

exec 9>"$(lockfile rws-backup)"
flock -w 3000 9 || die "a backup is still running"
allow_bucket "$BUCKET_HOST"

scratch=$RWS_SRV/backup/drill
wipe() { find "$scratch" -mindepth 1 -delete 2>/dev/null || true; }
fail() {
  wipe
  ping restore-drill fail "$1"
  die "restore drill failed: $1"
}
wipe
trap wipe EXIT
ping restore-drill start

snapshot=$(rws_compose run --rm --no-deps -T backup snapshots --latest 1 --host rws --json) || fail snapshots
id=$(jq -r '.[-1].id // empty' <<<"$snapshot")
time=$(jq -r '.[-1].time // empty' <<<"$snapshot")
[[ $id =~ ^[0-9a-f]{64}$ && -n $time ]] || fail no_snapshot
cutoff=$(($(date -u -d "$time" +%s) - 600))

rws_compose run --rm --no-deps -T backup restore "$id" --target /restore --include /data/raw/_manifest >/dev/null ||
  fail restore_manifest

# key and sha256 of stored objects recorded before the cutoff, sampled at random.
sample=$(mktemp)
find "$scratch/data/raw/_manifest" -name '*.jsonl' -type f -print0 2>/dev/null |
  xargs -0 -r cat |
  jq -r --argjson cutoff "$cutoff" '
    select(type == "object" and (.key | type) == "string" and (.sha256 | type) == "string")
    | select((.fetched_at.start | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) < $cutoff)
    | "\(.key) \(.sha256)"' 2>/dev/null |
  sort -u | shuf -n "$SAMPLE" >"$sample" || true
sampled=$(wc -l <"$sample")
((sampled == SAMPLE)) || fail too_few_objects

include=$scratch/.include
while read -r key _; do
  [[ $key =~ $KEY_RE ]] || fail bad_key
  printf '/data/raw/%s\n' "${key#raw/}"
done <"$sample" >"$include"
chmod 0644 "$include"
rws_compose run --rm --no-deps -T backup restore "$id" --target /restore --include-file /restore/.include >/dev/null ||
  fail restore_objects

matched=0
while read -r key sha; do
  file=$scratch/data/raw/${key#raw/}
  got=$(zstd -dc -- "$file" 2>/dev/null | sha256sum) || continue
  [[ ${got%% *} == "$sha" ]] && matched=$((matched + 1))
done <"$sample"
rm -f -- "$sample"

# shellcheck disable=SC2016 # a jq filter, not shell
ops_update --arg at "$(now_iso)" --argjson s "$sampled" --argjson m "$matched" \
  '.drill = {at: $at, sampled: $s, matched: $m}'
echo "restore drill: sampled $sampled, matched $matched"
((matched == sampled)) || fail mismatch
ping restore-drill
