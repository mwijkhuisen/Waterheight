#!/usr/bin/env bash
# rws-trusted-proxies (rws-firewall.service and every rws-tick, as rws-resolvers; #132, KG-228).
# Loads RWS_TRUSTED_PROXIES of /etc/rws/rws.env (the reverse proxies whose X-Forwarded-For Caddy
# reads: CIDRs separated by spaces) into the nftables sets trusted4 and trusted6, which the
# per-source connection cap of nftables.conf exempts: one proxy carries many visitors. Every entry
# must be an IPv4 or IPv6 address with an optional prefix length; anything else (a name, which nft
# would resolve, a zone id, a mapped address) empties both sets and fails: it never trusts more.
# Empty or unset: both sets empty.
#
# Usage: rws-trusted-proxies [--dry-run] [--quiet]
#   --quiet  log only a refused value (rws-tick, every 10 minutes)
set -euo pipefail
# shellcheck source=deploy/bin/rws-lib.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/rws-lib.sh"

quiet=0
for arg in "$@"; do
  case $arg in
    --dry-run) DRY_RUN=1 ;;
    --quiet) quiet=1 ;;
    *)
      echo "usage: rws-trusted-proxies [--dry-run] [--quiet]" >&2
      exit 64
      ;;
  esac
done

readonly HEX='[0-9a-f]{1,4}'
# a.b.c.d, each 0-255 without a leading zero.
ipv4() {
  local octets o
  [[ $1 =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
  IFS=. read -r -a octets <<<"$1"
  for o in "${octets[@]}"; do [[ $o =~ ^(0|[1-9][0-9]*)$ ]] && ((o <= 255)) || return 1; done
}
# Eight groups of 1-4 hex digits, or at most seven around one `::`.
ipv6() {
  local a=$1 g
  [[ $a =~ ^($HEX:){7}$HEX$ ]] && return 0
  [[ $a =~ ^(($HEX:){0,6}$HEX)?::(($HEX:){0,6}$HEX)?$ ]] || return 1
  a=${a//::/:} a=${a#:} a=${a%:}
  IFS=: read -r -a g <<<"$a"
  ((${#g[@]} <= 7))
}
# Nothing, or `/` and a prefix length of at most $2.
prefix() { [[ -z $1 ]] || { [[ $1 =~ ^/(0|[1-9][0-9]{0,2})$ ]] && ((${1#/} <= $2)); }; }

unset RWS_TRUSTED_PROXIES
load_env || true # no rws.env: nobody is trusted
read -r -a entries <<<"${RWS_TRUSTED_PROXIES:-}"
v4=() v6=() bad=0 n=0
for e in "${entries[@]}"; do
  n=$((n + 1)) e=${e,,}
  addr=${e%%/*}
  if ipv4 "$addr" && prefix "${e#"$addr"}" 32; then
    v4+=("$e")
  elif ipv6 "$addr" && prefix "${e#"$addr"}" 128; then
    v6+=("$e")
  else
    bad=$n
    break
  fi
done
((bad == 0)) || v4=() v6=()

batch='flush set inet rws trusted4'$'\n''flush set inet rws trusted6'$'\n'
((${#v4[@]} == 0)) || batch+="add element inet rws trusted4 { $(IFS=,; echo "${v4[*]}") }"$'\n'
((${#v6[@]} == 0)) || batch+="add element inet rws trusted6 { $(IFS=,; echo "${v6[*]}") }"$'\n'
if ((DRY_RUN)); then printf '%s' "$batch"; else printf '%s' "$batch" | nft -f -; fi
# The entry's number, never its text.
((bad == 0)) ||
  die "RWS_TRUSTED_PROXIES entry $bad is not an IPv4 or IPv6 address or CIDR: no proxy is exempt from the connection cap"
((quiet || DRY_RUN)) ||
  log "connection cap: ${#v4[@]} IPv4 and ${#v6[@]} IPv6 trusted proxy ranges exempt (RWS_TRUSTED_PROXIES)"
