#!/usr/bin/env bash
# rws-resolvers (rws-firewall.service, rws-resolvers.path, once at boot once the
# network is online, and every rws-tick; A§11.1; issue #16 P1b).
# Loads the host's DNS resolvers into the nftables sets that containers may send
# DNS to (the egress rule "TCP 443 plus DNS to the resolver"). With the
# systemd-resolved stub, Docker forwards to resolved's upstream servers, so
# those are the ones allowed.
#
# Usage: rws-resolvers [--dry-run] [--quiet]
#   --quiet  log only a missing resolver (rws-tick, every 10 minutes)
set -euo pipefail
# shellcheck source=deploy/bin/rws-lib.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/rws-lib.sh"

quiet=0
for arg in "$@"; do
  case $arg in
    --dry-run) DRY_RUN=1 ;;
    --quiet) quiet=1 ;;
    *)
      echo "usage: rws-resolvers [--dry-run] [--quiet]" >&2
      exit 64
      ;;
  esac
done

# nameserver lines of a resolv.conf, without zone ids.
servers() { awk '$1 == "nameserver" { sub(/%.*/, "", $2); print $2 }' "$1" 2>/dev/null || true; }

conf=${RWS_RESOLV_CONF:-/etc/resolv.conf}
if ! servers "$conf" | grep -qvE '^(127\.|::1$)' && [[ -r /run/systemd/resolve/resolv.conf ]]; then
  conf=/run/systemd/resolve/resolv.conf
fi
v4=() v6=()
while IFS= read -r addr; do
  if [[ $addr =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ && $addr != 127.* ]]; then
    v4+=("$addr")
  elif [[ $addr =~ ^[0-9a-fA-F:]+$ && $addr == *:* && $addr != ::1 ]]; then
    v6+=("$addr")
  fi
done < <(servers "$conf")

batch='flush set inet rws resolvers4'$'\n''flush set inet rws resolvers6'$'\n'
((${#v4[@]} == 0)) || batch+="add element inet rws resolvers4 { $(IFS=,; echo "${v4[*]}") }"$'\n'
((${#v6[@]} == 0)) || batch+="add element inet rws resolvers6 { $(IFS=,; echo "${v6[*]}") }"$'\n'
if ((DRY_RUN)); then
  printf '%s' "$batch"
  exit 0
fi
printf '%s' "$batch" | nft -f -
((quiet)) || log "container DNS allowed to ${#v4[@]} IPv4 and ${#v6[@]} IPv6 resolvers (from $conf)"
# No resolver yet (early boot): rws-resolvers.path runs this again when resolv.conf is written.
((${#v4[@]} + ${#v6[@]} > 0)) || log "warning: no resolver found; containers have no DNS until resolv.conf changes or the next rws-tick"
