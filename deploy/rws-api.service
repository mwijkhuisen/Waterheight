# The API, which also serves the built map client.
#
# Installed by deploy/install-ubuntu.sh, which substitutes @REPO_DIR@,
# @APP_USER@ and @NODE@. Edit the copy in /etc/systemd/system/ or re-run the
# installer after changing this template.

[Unit]
Description=RWS monitoring map API
Documentation=https://github.com/mwijkhuisen/rws
# Wants= rather than Requires=: a database that is briefly down should mean a
# restart loop, not a unit that stays dead after Postgres recovers.
Wants=postgresql.service
After=network-online.target postgresql.service

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@REPO_DIR@

# The app reads this file itself rather than systemd parsing it, so dotenv's
# quoting rules apply in exactly one place instead of two.
Environment=NODE_ENV=production
Environment=ENV_FILE=@REPO_DIR@/.env

# Migrations before the listener. The runner is idempotent and refuses to run
# an edited migration, so a restart that has nothing to apply is a no-op.
# (Type=simple permits exactly one ExecStart, hence Pre.)
ExecStartPre=@NODE@ packages/server/dist/cli/migrate.js
ExecStart=@NODE@ packages/server/dist/index.js

Restart=on-failure
RestartSec=5s
# Fastify closes the listener and drains on SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=30s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rws-api

# Hardening. The service only ever reads its own tree and talks to Postgres
# over TCP, so it needs no write access anywhere.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# read-only rather than true when the install lives under /home:
# ProtectHome=true makes /home appear EMPTY to the service, so a repo
# there is invisible and even WorkingDirectory cannot be entered.
ProtectHome=@PROTECT_HOME@
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
