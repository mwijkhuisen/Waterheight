# The public site (A§12.2; issue #16 P1b). Every A§12.2 header, noindex until
# the public launch (P12), /healthz, the two coarse status files, (P2a) the
# api's two health paths and (P3) the basemap tiles and the immutable assets.
# No CORS headers, no owner site (P9; WireGuard-only
# from P12a). scripts/verify-prod.ts compares these headers with A§12.2 byte for
# byte; the header block also applies to the proxied responses.
{$RWS_DOMAIN} {
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests; report-to csp"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Robots-Tag "noindex"
		-Server
	}

	# Access log with masked addresses (IPv4 /24, IPv6 /48), one file a day, kept 14 days (A§12.2 privacy).
	log {
		output file /data/access/access.log {
			roll_interval 24h
			roll_keep 15
			roll_keep_for 336h
		}
		format filter {
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			request>headers>X-Forwarded-For ip_mask 24 48
			request>headers>Authorization delete
			request>headers>Cookie delete
			wrap json
		}
	}

	# Compression for everything except the tile files: a PMTiles file is read
	# with Range requests, and a Content-Encoding on a 206 would break the byte
	# offsets the client asked for (its tiles are gzip inside the archive
	# already). The path matcher folds case and merges slashes, so this
	# exclusion covers at least every path @tiles_files below can match.
	@compressible {
		not path /tiles/*
	}
	encode @compressible zstd gzip

	# The User-Agent of every capture request names https://<domain>/over.
	redir /over / 308

	handle /healthz {
		respond 200
	}

	# Status files: public, coarse, never cached, both from the root-owned
	# ops directory: capture.json as rws-status-copy checked and copied it from
	# capture's own directory, ops.json from the backup, drill and disk jobs.
	handle /status/capture.json {
		header Cache-Control "no-store"
		rewrite * /capture.json
		root * /srv/rws/public/ops
		file_server
	}
	handle /status/ops.json {
		header Cache-Control "no-store"
		rewrite * /ops.json
		root * /srv/rws/public/ops
		file_server
	}
	handle /status/* {
		respond 404
	}

	# The api (P2a): exactly its two health paths, GET or HEAD, any query (the
	# api answers 400 to a parameter it does not know). The expression compares
	# the request path as sent, case and all (the path matcher would fold case,
	# merge slashes and resolve dot segments). Every other /api/ path is a 404
	# from Caddy. Named matchers keep this order: health first.
	@api_health {
		method GET HEAD
		expression `{path} == '/api/v1/health' || {path} == '/api/v1/health/sources'`
	}
	@api path /api/*
	handle @api_health {
		# Deferred like the site block: nothing names the upstream software.
		header -Via
		reverse_proxy api:8080 {
			header_down -Server
		}
	}
	handle @api {
		respond 404
	}

	# The basemap tiles (P3, ADR-0016), read-only from /srv/rws/tiles, which the
	# basemap-promote job fills (the network-facing fetch job never writes it).
	# Three kinds of path, then a 404 for the rest. Every match is an exact,
	# case-sensitive one on the request path as Go decoded it, not cleaned
	# (like @api_health): a folded-case, doubled-slash or dot-segment spelling is
	# no tile file, while a percent-escape such as %2D reaches the same file as
	# the plain name. The file matcher lets a route answer only for a file that
	# exists: file_server's own 404 would otherwise carry the Cache-Control set
	# before it, and a cached 404 must never be immutable.
	#
	# The manifest: short TTL, never immutable (it changes on every promote).
	@tiles_manifest {
		method GET HEAD
		expression `{path} == '/tiles/manifest.json'`
		file {
			root /srv/rws/tiles
			try_files /manifest.json
		}
	}
	handle @tiles_manifest {
		header Cache-Control "public, max-age=60"
		uri strip_prefix /tiles
		root * /srv/rws/tiles
		file_server
	}

	# The tile files: dated names, so immutable. file_server answers Range
	# requests (206, Content-Range) itself and lists no directory (no browse).
	# The regex is TILE_FILE_RE of packages/core/src/tiles-manifest.ts.
	@tiles_files {
		method GET HEAD
		expression `{path}.matches('^/tiles/(basemap|planet-z6)-[0-9]{8}\\.pmtiles$')`
		file {
			root /srv/rws/tiles
			try_files /{http.request.uri.path.file}
		}
	}
	# Only one explicit byte range is served, the request pmtiles.js makes
	# (bytes=<first>-<last>). No Range (the whole multi-GB file), an open or
	# suffix range and several ranges (a multipart answer about 30 times the
	# size of the request) are a 416 with the site headers and no Cache-Control
	# (SR-1, R-061). The header placeholder joins repeated Range fields with a
	# comma, so a second Range field fails the match too.
	handle @tiles_files {
		@one_range expression `{header.Range}.matches('^bytes=[0-9]+-[0-9]+$')`
		handle @one_range {
			header Cache-Control "public, max-age=31536000, immutable"
			uri strip_prefix /tiles
			root * /srv/rws/tiles
			file_server
		}
		handle {
			respond 416
		}
	}

	# Everything else under /tiles (the directory itself, .staging, a temp
	# manifest, a file that does not exist, any other method): a 404 from Caddy,
	# whatever the disk holds, with no Cache-Control.
	@tiles path /tiles /tiles/*
	handle @tiles {
		respond 404
	}

	# No dotfile from the web root or /assets: a path with a segment that
	# starts with "." (the path decoded and cleaned, as file_server reads it)
	# is a 404, whatever /srv/www holds. ACME challenges are answered before
	# any route; a file under /.well-known would need its own route above this
	# one. A regexp, not a path matcher: Caddy re-sorts path-only matchers
	# (a probe put `path */.*` after @assets) but keeps this order.
	@dotfiles path_regexp /\.
	handle @dotfiles {
		respond 404
	}

	# Vite's hashed assets and the pinned map glyphs and sprites under
	# /assets/map/<commit7>/ (a new commit is a new directory): immutable
	# (A§9.1), for a file that exists; a miss or a directory falls to the
	# catch-all below, with no Cache-Control. The HTML pages carry none either.
	@assets {
		path /assets/*
		not path */
		file {
			root /srv/www
			try_files {path}
		}
	}
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv/www
		file_server
	}

	handle {
		root * /srv/www
		file_server
	}
}

# Container healthcheck only: loopback inside the container, never published.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /healthz 200
}
