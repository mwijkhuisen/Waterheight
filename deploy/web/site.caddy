# The public site (A§12.2; issue #16 P1b). Every A§12.2 header, noindex until
# the public launch (P12), /healthz, the two coarse status files, (P2a, P4b) the
# api under /api/v1/, (P3) the basemap tiles and the immutable assets, (P4b) the
# web app with its fallback for app routes, and (P9a) the static publisher's
# files under /data/v1/ with /runtime-config.json. No CORS headers, no owner
# site: that is deploy/web/owner.caddy in its own container (compose.owner.yaml;
# WireGuard-only from P12a). scripts/verify-prod.ts compares these headers with
# A§12.2 byte for byte; the header block also applies to the proxied responses.
{$RWS_DOMAIN} {
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests; report-to csp"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Reporting-Endpoints "csp=\"/api/v1/beacon\""
		X-Robots-Tag "noindex"
		-Server
	}

	# Access log with masked addresses (IPv4 /24, IPv6 /48), one file a day, kept 14 days (A§12.2 privacy).
	log {
		output file /data/access/access.log {
			roll_interval 24h
			roll_keep 15
			roll_keep_for 336h
		}
		format filter {
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			request>headers>X-Forwarded-For ip_mask 24 48
			request>headers>Authorization delete
			request>headers>Cookie delete
			wrap json
		}
	}

	# Compression for everything except the tile files: a PMTiles file is read
	# with Range requests, and a Content-Encoding on a 206 would break the byte
	# offsets the client asked for (its tiles are gzip inside the archive
	# already). The path matcher folds case and merges slashes, so this
	# exclusion covers at least every path @tiles_files below can match.
	@compressible {
		not path /tiles/*
	}
	encode @compressible zstd gzip

	# The User-Agent of every capture request names https://<domain>/over.
	redir /over / 308

	# The beacon (P9b, A§9.2): the one POST of the site, for CSP and Reporting API
	# reports. Exact method and path, compared as sent (an expression, not a path
	# matcher, which folds case: /API/v1/beacon and every other POST stay the 405
	# below), placed before it. The body is capped at 8 KB here, as in the api; a
	# 413 from this cap carries no site headers (KG-107). X-Rws-Client is the client
	# address (the TCP peer, or a trusted proxy's X-Forwarded-For: KG-228), set here and replacing a client's
	# value: the api keys its rate limit on it.
	@beacon {
		method POST
		expression `{path} == '/api/v1/beacon'`
	}
	handle @beacon {
		request_body {
			max_size 8KiB
		}
		header -Via
		reverse_proxy api:8080 {
			header_up -Forwarded
			header_up -X-Real-IP
			header_up X-Rws-Client {client_ip}
			header_down -Server
			header_down -X-Degraded
		}
	}

	# Only GET and HEAD, on every route (SR-3): any other method is this 405,
	# with Allow and the site headers. file_server's own 405 (the pages, the
	# assets, the status files) would carry none of them and name the server.
	@write not method GET HEAD
	handle @write {
		header Allow "GET, HEAD"
		respond 405
	}

	handle /healthz {
		respond 200
	}

	# Status files: public, coarse, never cached, both from the root-owned
	# ops directory: capture.json as rws-status-copy checked and copied it from
	# capture's own directory, ops.json from the backup, drill and disk jobs.
	handle /status/capture.json {
		header Cache-Control "no-store"
		rewrite * /capture.json
		root * /srv/rws/public/ops
		file_server
	}
	handle /status/ops.json {
		header Cache-Control "no-store"
		rewrite * /ops.json
		root * /srv/rws/public/ops
		file_server
	}
	handle /status/* {
		respond 404
	}
	handle /status {
		respond 404
	}

	# Which audience this site shows (P9a): the web app reads it once. The owner
	# site (owner.caddy) answers {"audience":"owner"} from its own container.
	handle /runtime-config.json {
		header Content-Type "application/json"
		header Cache-Control "no-cache"
		respond `{"audience":"public"}` 200
	}

	# The api (P2a: its two health paths; P4b: everything under /api/v1/). GET
	# or HEAD only (@write above), any query: the api validates every parameter
	# and answers its own 400s and JSON 404s (A§9.2). The expression compares the
	# request path as sent, case and all (the path matcher would fold case, merge
	# slashes and resolve dot segments), and no dot segment is passed on: a dot
	# segment that stays under /api is a 404 from Caddy, one that climbs out of
	# /api is answered by the route of the cleaned path (SR-4). The api reads no
	# request body: at most 1 KB is accepted. Any other /api path is a 404 from
	# Caddy. The two matchers exclude each other, so their order does not matter.
	@api {
		method GET HEAD
		expression `{path}.startsWith('/api/v1/') && !{path}.contains('/.')`
	}
	@api_other {
		path /api /api/*
		not expression `{path}.startsWith('/api/v1/') && !{path}.contains('/.')`
	}
	handle @api {
		request_body {
			max_size 1KB
		}
		# Deferred like the site block: nothing names the upstream software.
		header -Via
		# The degraded stand-in (P9a, A§9.1), for /api/v1/snapshot only: when the
		# api is down the map still gets the newest snapshot as a static file.
		# Two cases, two mechanisms (Caddy 2.11.4, measured): an upstream 502, 503
		# or 504 *response* (the api answers 503 itself) is caught only by
		# handle_response inside the proxy, a dead upstream (a dial failure is a
		# 502, a timeout a 504) only by handle_errors below. Both serve latest.json
		# (the file the publisher writes last-but-one each cycle) with status 200,
		# X-Degraded: 1 and no-store; the web app then shows its banner. Any other
		# /api path keeps the plain proxy: copy_response inside handle_response
		# would drop the upstream's headers (Content-Type, Retry-After), and a
		# site-wide handle_errors would also change file_server 404s (KG-107).
		# header_down -X-Degraded: only this site sets it, never the upstream.
		@snapshot expression `{path} == '/api/v1/snapshot'`
		handle @snapshot {
			reverse_proxy api:8080 {
				header_up -Forwarded
				header_up -X-Real-IP
				header_up X-Rws-Client {client_ip}
				header_down -Server
				header_down -X-Degraded
				@upstream_5xx status 502 503 504
				handle_response @upstream_5xx {
					header X-Degraded "1"
					header Cache-Control "no-store"
					rewrite * /latest.json
					root * /srv/rws/public/www/v1
					file_server {
						precompressed zstd gzip
					}
				}
			}
		}
		handle {
			# The api keys its per-client rate limit on X-Rws-Client alone, which
			# Caddy sets to {client_ip} (replacing a client's value): the TCP peer,
			# or X-Forwarded-For only from a peer in RWS_TRUSTED_PROXIES (KG-228).
			# Other client-address headers (True-Client-IP, X-Client-IP, …) are
			# never read, and the api never reads X-Forwarded-For itself.
			reverse_proxy api:8080 {
				header_up -Forwarded
				header_up -X-Real-IP
				header_up X-Rws-Client {client_ip}
				header_down -Server
				header_down -X-Degraded
			}
		}
	}
	# The dead-upstream half of the stand-in. Error routes get no site header
	# block and would show `Server: Caddy`, so the route sets what it needs, and
	# file_server must be told to answer 200, not the error's status.
	handle_errors 502 503 504 {
		# The A§12.2 set again (review SEC-1): an error route gets no site header
		# block. It covers the stand-in and every other 502, 503 or 504 (the api
		# down for another path), which then answers its status, never naming Caddy.
		header {
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests; report-to csp"
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "geolocation=(), camera=(), microphone=()"
			Cross-Origin-Opener-Policy "same-origin"
			Cross-Origin-Resource-Policy "same-origin"
			Reporting-Endpoints "csp=\"/api/v1/beacon\""
			X-Robots-Tag "noindex"
			-Server
		}
		@snapshot_down expression `{http.request.orig_uri.path} == '/api/v1/snapshot'`
		handle @snapshot_down {
			header X-Degraded "1"
			header Cache-Control "no-store"
			rewrite * /latest.json
			root * /srv/rws/public/www/v1
			file_server {
				precompressed zstd gzip
				status 200
			}
		}
		handle {
			respond {err.status_code}
		}
	}
	handle @api_other {
		respond 404
	}

	# The basemap tiles (P3, ADR-0016), read-only from /srv/rws/tiles, which the
	# basemap-promote job fills (the network-facing fetch job never writes it).
	# Three kinds of path, then a 404 for the rest. Every match is an exact,
	# case-sensitive one on the request path as Go decoded it, not cleaned
	# (like @api_health): a folded-case, doubled-slash or dot-segment spelling is
	# no tile file, while a percent-escape such as %2D reaches the same file as
	# the plain name. The file matcher lets a route answer only for a file that
	# exists: file_server's own 404 would otherwise carry the Cache-Control set
	# before it, and a cached 404 must never be immutable.
	#
	# The manifest: short TTL, never immutable (it changes on every promote).
	@tiles_manifest {
		method GET HEAD
		expression `{path} == '/tiles/manifest.json'`
		file {
			root /srv/rws/tiles
			try_files /manifest.json
		}
	}
	handle @tiles_manifest {
		header Cache-Control "public, max-age=60"
		uri strip_prefix /tiles
		root * /srv/rws/tiles
		file_server
	}

	# The tile files: dated names, so immutable. file_server answers Range
	# requests (206, Content-Range) itself and lists no directory (no browse).
	# The regex is TILE_FILE_RE of packages/core/src/tiles-manifest.ts.
	@tiles_files {
		method GET HEAD
		expression `{path}.matches('^/tiles/(basemap|planet-z6)-[0-9]{8}\\.pmtiles$')`
		file {
			root /srv/rws/tiles
			try_files /{http.request.uri.path.file}
		}
	}
	# Only one explicit byte range is served, the request pmtiles.js makes
	# (bytes=<first>-<last>). No Range (the whole multi-GB file), an open or
	# suffix range and several ranges (a multipart answer about 30 times the
	# size of the request) are a 416 with the site headers and no Cache-Control
	# (SR-1, R-061). The header placeholder joins repeated Range fields with a
	# comma, so a second Range field fails the match too. So is a range with
	# If-Range (one that does not match gets the whole file, 200), If-Match or
	# If-Unmodified-Since (a failed one is a 412 that would be marked immutable)
	# (SR2-1); pmtiles.js sends none of them. If-None-Match and If-Modified-Since
	# keep their 304. An empty header is no header, to Go as to the placeholder.
	handle @tiles_files {
		@one_range expression `{header.Range}.matches('^bytes=[0-9]+-[0-9]+$') && {header.If-Range} == '' && {header.If-Match} == '' && {header.If-Unmodified-Since} == ''`
		handle @one_range {
			header Cache-Control "public, max-age=31536000, immutable"
			uri strip_prefix /tiles
			root * /srv/rws/tiles
			file_server
		}
		handle {
			respond 416
		}
	}

	# The river overlay (P6b): the URL /tiles/rivers-<ver>.pmtiles, but the file
	# is installed by rws-rivers-refresh (root) into the root-owned rivers
	# directory, never into /srv/rws/tiles, which the promote job owns. Its own
	# matcher, so the basemap regex above stays as P3 wrote it; the same
	# one-range rule, file existence and immutable name as the basemap tiles.
	@tiles_rivers {
		method GET HEAD
		expression `{path}.matches('^/tiles/rivers-[0-9]{8}\\.pmtiles$')`
		file {
			root /srv/rws/public/data/v1/rivers
			try_files /{http.request.uri.path.file}
		}
	}
	handle @tiles_rivers {
		@one_range_rivers expression `{header.Range}.matches('^bytes=[0-9]+-[0-9]+$') && {header.If-Range} == '' && {header.If-Match} == '' && {header.If-Unmodified-Since} == ''`
		handle @one_range_rivers {
			header Cache-Control "public, max-age=31536000, immutable"
			uri strip_prefix /tiles
			root * /srv/rws/public/data/v1/rivers
			file_server
		}
		handle {
			respond 416
		}
	}

	# Everything else under /tiles (the directory itself, .staging, a temp
	# manifest, a file that does not exist, any other method): a 404 from Caddy,
	# whatever the disk holds, with no Cache-Control.
	@tiles path /tiles /tiles/*
	handle @tiles {
		respond 404
	}

	# The river data (P6b), read-only from the two directories that
	# rws-rivers-refresh fills (docs/runbooks/geo-refresh.md): the manifest (short
	# TTL, it changes on every refresh), the dated reaches file and the dated ODbL
	# download (immutable). Exact, case-sensitive matches with a file matcher, so
	# a missing file is a 404 without Cache-Control; everything else under
	# /data/v1/rivers and /downloads is a 404. The rest of /data/v1/ is the
	# static publisher's (below).
	# The download is gzip data, not a compressed transfer: application/gzip and
	# never a Content-Encoding (it is not in encode's default types, and the
	# gunzipped first bytes are what verify-prod reads with a Range).
	@rivers_manifest {
		method GET HEAD
		expression `{path} == '/data/v1/rivers/manifest.json'`
		file {
			root /srv/rws/public/data/v1/rivers
			try_files /manifest.json
		}
	}
	handle @rivers_manifest {
		header Cache-Control "public, max-age=60"
		uri strip_prefix /data/v1/rivers
		root * /srv/rws/public/data/v1/rivers
		file_server
	}
	@rivers_reaches {
		method GET HEAD
		expression `{path}.matches('^/data/v1/rivers/reaches-[0-9]{8}\\.json$')`
		file {
			root /srv/rws/public/data/v1/rivers
			try_files /{http.request.uri.path.file}
		}
	}
	handle @rivers_reaches {
		header Cache-Control "public, max-age=31536000, immutable"
		uri strip_prefix /data/v1/rivers
		root * /srv/rws/public/data/v1/rivers
		file_server
	}
	@rivers_other path_regexp ^/data/v1/rivers(/|$)
	handle @rivers_other {
		respond 404
	}
	@rivers_download {
		method GET HEAD
		expression `{path}.matches('^/downloads/rivers-[0-9]{8}\\.geojson\\.gz$')`
		file {
			root /srv/rws/public/downloads
			try_files /{http.request.uri.path.file}
		}
	}
	handle @rivers_download {
		header Cache-Control "public, max-age=31536000, immutable"
		header Content-Type "application/gzip"
		uri strip_prefix /downloads
		root * /srv/rws/public/downloads
		file_server
	}
	@downloads_other path_regexp ^/downloads(/|$)
	handle @downloads_other {
		respond 404
	}

	# The static publisher's files (P9a, A§9.1): precomputed, precompressed
	# (.zst and .gz beside each file; file_server picks by Accept-Encoding, sets
	# Content-Encoding and Vary, and encode leaves an encoded response alone), from
	# the one directory the publisher writes, mounted read-only at
	# /srv/rws/public/www/v1 (its .tmp and .state are not mounted). Inside the
	# /data/v1 route the prefix /data is stripped, so /data/v1/x is the file
	# /srv/rws/public/www/v1/x. Then one exact, case-sensitive matcher per cache
	# class on the path as `uri strip_prefix` leaves it (canonical: dot segments
	# resolved, slashes merged, so the class and the file come from the same
	# path), each with a file matcher: a file that does not exist, a .zst or .gz
	# name, a dot-led segment, a directory and any other /data/v1 path is a 404
	# with no Cache-Control and no listing. Short classes
	# revalidate; a settled day, its frames file and a dated warnings file never
	# change under their name: immutable. (`uri` runs before the inner handles.)
	@data path_regexp ^/data/v1(/|$)
	handle @data {
		uri strip_prefix /data
		@data_live {
			method GET HEAD
			expression `{path} == '/v1/meta.json' || {path} == '/v1/latest.json'`
			file {
				root /srv/rws/public/www
				try_files {path}
			}
		}
		handle @data_live {
			header Cache-Control "public, max-age=60, stale-while-revalidate=300"
			root * /srv/rws/public/www
			file_server {
				precompressed zstd gzip
			}
		}
		@data_recent {
			method GET HEAD
			expression `{path}.matches('^/v1/recent/[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{4}\\.json$')`
			file {
				root /srv/rws/public/www
				try_files {path}
			}
		}
		handle @data_recent {
			header Cache-Control "public, max-age=300, stale-while-revalidate=600"
			root * /srv/rws/public/www
			file_server {
				precompressed zstd gzip
			}
		}
		@data_slow {
			method GET HEAD
			expression `{path} in ['/v1/stations.json', '/v1/sources.json', '/v1/frames/recent.json', '/v1/forecast/latest.json'] || {path}.matches('^/v1/series/[a-z]{2}\\.[a-z0-9-]+\\.[A-Za-z0-9_-][A-Za-z0-9._-]{0,70}/recent\\.json$')`
			file {
				root /srv/rws/public/www
				try_files {path}
			}
		}
		handle @data_slow {
			header Cache-Control "public, max-age=300"
			root * /srv/rws/public/www
			file_server {
				precompressed zstd gzip
			}
		}
		@data_immutable {
			method GET HEAD
			expression `{path}.matches('^/v1/(settled/[0-9]{4}-[0-9]{2}-[0-9]{2}/v[1-9][0-9]{0,5}/[0-9]{4}|frames/[0-9]{4}-[0-9]{2}-[0-9]{2}/v[1-9][0-9]{0,5}|warnings/[0-9]{4}-[0-9]{2}-[0-9]{2})\\.json$')`
			file {
				root /srv/rws/public/www
				try_files {path}
			}
		}
		handle @data_immutable {
			header Cache-Control "public, max-age=31536000, immutable"
			root * /srv/rws/public/www
			file_server {
				precompressed zstd gzip
			}
		}
		@data_warnings {
			method GET HEAD
			expression `{path} == '/v1/warnings/latest.geojson'`
			file {
				root /srv/rws/public/www
				try_files {path}
			}
		}
		handle @data_warnings {
			header Cache-Control "public, max-age=60"
			header Content-Type "application/geo+json"
			root * /srv/rws/public/www
			file_server {
				precompressed zstd gzip
			}
		}
		@data_status {
			method GET HEAD
			expression `{path} == '/v1/status.json'`
			file {
				root /srv/rws/public/www
				try_files {path}
			}
		}
		handle @data_status {
			header Cache-Control "public, max-age=30"
			root * /srv/rws/public/www
			file_server {
				precompressed zstd gzip
			}
		}
		handle {
			respond 404
		}
	}

	# No dotfile from the web root or /assets: a path with a segment that
	# starts with "." (the path decoded and cleaned, as file_server reads it)
	# is a 404, whatever /srv/www holds. ACME challenges are answered before
	# any route; a file under /.well-known would need its own route above this
	# one. A regexp, not a path matcher: Caddy re-sorts path-only matchers
	# (a probe put `path */.*` after @assets) but keeps this order.
	@dotfiles path_regexp /\.
	handle @dotfiles {
		respond 404
	}

	# Vite's hashed assets and the pinned map glyphs and sprites under
	# /assets/map/<commit7>/ (a new commit is a new directory): immutable
	# (A§9.1), for a file that exists; any other /assets path is the 404 below,
	# with no Cache-Control.
	@assets {
		path /assets/*
		not path */
		file {
			root /srv/www
			try_files {path}
		}
	}
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv/www
		file_server
	}
	# Any other /assets path is a 404 from Caddy, never the app below: an HTML
	# 200 under an asset path would be cached as that asset (P4b). A regexp, so
	# Caddy keeps it after @assets.
	@assets_miss path_regexp ^/assets(/|$)
	handle @assets_miss {
		respond 404
	}

	# The pages and the app routes (P4b). A file is served as it is. A path with
	# no file and no dot in its last segment is an app route: under /en/ the
	# English page answers, anywhere else the Dutch one, and the app shows its
	# own "not found" for a route it does not know. A missing file with an
	# extension (favicon.ico, robots.txt) stays a 404, answered here so that it
	# keeps the site headers (file_server's own 404 would carry none, KG-107).
	# Everything here is revalidated on every use (no-cache, CR-6): a page that
	# a browser kept past a deploy would ask for asset names the new image no
	# longer has. /api, /status, /tiles and /assets never get here.
	handle {
		header Cache-Control "no-cache"
		root * /srv/www
		@app_en {
			path_regexp ^/en/
			not file {path} {path}/
			not path_regexp \.[^/]*$
		}
		@app {
			not file {path} {path}/
			not path_regexp \.[^/]*$
		}
		rewrite @app_en /en/index.html
		rewrite @app /index.html
		@missing not file {path} {path}/
		respond @missing 404
		file_server
	}
}

# Container healthcheck only: loopback inside the container, never published.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /healthz 200
}
