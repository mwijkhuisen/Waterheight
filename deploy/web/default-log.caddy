# Caddy's own log on stderr (#133, KG-314), imported into the global options of Caddyfile, Caddyfile.owner and the CI
# deploy/tests/e2e/Caddyfile.ci. Docker's `local` driver keeps it on the VPS, so it gets the masks of the access logs
# (site.caddy, owner.caddy). Measured on Caddy 2.11.4: a 502 that handle_errors answers is logged at debug only, but
# reverse_proxy warns "aborting with incomplete response" (the api dies mid-answer, or a visitor leaves while a large
# answer is still being sent) with the request: the full remote_ip, client_ip, X-Forwarded-For and the X-Rws-Client
# Caddy sends the api, and an error text such as "write tcp 172.18.0.5:443->203.0.113.7:51234: write: broken pipe".
# The error text has no field to mask, so every address in it is replaced. chaos.sh proves it on the running stack.
log default {
	format filter {
		request>remote_ip ip_mask 24 48
		request>client_ip ip_mask 24 48
		request>headers>X-Forwarded-For ip_mask 24 48
		request>headers>X-Rws-Client ip_mask 24 48
		request>headers>Authorization delete
		request>headers>Cookie delete
		request>headers>Forwarded delete
		request>headers>X-Real-Ip delete
		request>headers>Cf-Connecting-Ip delete
		request>headers>True-Client-Ip delete
		request>headers>X-Client-Ip delete
		request>headers>Fastly-Client-Ip delete
		error regexp `\d{1,3}(\.\d{1,3}){3}|\[[0-9A-Fa-f:.%]+\]` [address]
		wrap json
	}
}
