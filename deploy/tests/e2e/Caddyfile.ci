# CI only (deploy/tests/e2e/run.sh): the production site with the ACME CA
# pointed at Pebble. Only these globals differ from deploy/web/Caddyfile.
{
	admin off
	email ci@rivierstanden.example
	acme_ca https://pebble:14000/dir
	acme_ca_root /etc/caddy/ci-ca.pem
	# P9b (review SEC-2): a slow client cannot hold a connection: 10 s for the headers and for a body (the largest
	# accepted is the beacon's 8 KiB), 2 minutes idle between keep-alive requests.
	servers {
		timeouts {
			read_header 10s
			read_body 10s
			idle 2m
		}
	}
}

import /etc/caddy/site.caddy
