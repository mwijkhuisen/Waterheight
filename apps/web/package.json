{
  "name": "@rws/web",
  "private": true,
  "type": "module",
  "scripts": {
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy globalVariable baseLocale --emit-ts-declarations --silent",
    "build": "pnpm i18n && tsc -b && vite build",
    "build:e2e": "pnpm i18n && tsc -b && vite build --mode e2e",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@rws/contracts": "workspace:*",
    "@rws/core": "workspace:*",
    "@tanstack/react-query": "5.104.2",
    "echarts": "6.1.0",
    "maplibre-gl": "6.14.0",
    "pmtiles": "4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "temporal-polyfill": "1.0.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@inlang/paraglide-js": "2.27.0",
    "@inlang/plugin-message-format": "4.5.3",
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4"
  }
}
