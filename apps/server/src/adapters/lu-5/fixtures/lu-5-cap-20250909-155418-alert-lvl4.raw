  <info>
    <language>en-US</language>
    <category>Env</category>
    <event>Flood</event>
    <urgency>Unknown</urgency>
    <severity>Unknown</severity>
    <certainty>Unknown</certainty>
    <eventCode>
      <valueName>LU-Alert</valueName>
      <value>FLOOD</value>
    </eventCode>
    <effective>2025-09-09T17:00:00+02:00</effective>
    <expires>2025-09-10T00:00:00+02:00</expires>
    <senderName>LU</senderName>
    <headline>Floods in the south of Luxembourg</headline>
    <description>&lt;p&gt;&lt;strong&gt;Information/End of floods&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Since this morning, water levels have been falling at all gauging stations along the Alzette.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;The water levels are now all below the &amp;quot;Cote de vigilance orange&amp;quot;.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Due to the still elevated water levels, increased caution is still advised along watercourses. A renewed rise in the coming days is not expected.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;The awareness level floods for the south of Luxembourg has been cancelled. Currently no risk of floods.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Follow the situation, possible changes in awareness levels and possible other active warnings.&lt;/strong&gt;&lt;/p&gt;</description>
    <parameter>
      <valueName>urn:oasis:names:tc:emergency:cap:1.2:profile:cap-lu:1.0:name</valueName>
      <value>Information inondations sud</value>
    </parameter>
