e à l'heure TU le 03/11/2009.","altitude_ref_alti_station":298.12,"code_systeme_alti_site":3,"code_commune_station":"68162","libelle_commune":"KAYSERSBERG VIGNOBLE","code_departement":"68","code_region":"44","libelle_region":"GRAND EST","code_cours_eau":"A21-0200","libelle_cours_eau":"La Weiss","uri_cours_eau":"http://id.eaufrance.fr/CEA/A21-0200","descriptif_station":null,"date_maj_station":"2026-03-23T00:00:00Z","date_ouverture_station":"2006-08-30T00:00:00Z","date_fermeture_station":null,"commentaire_influence_locale_station":"Voir remarque générale sur la non mesure du débit industriel prélevé en amont.","code_regime_station":1,"qualification_donnees_station":20,"code_finalite_station":"1 2","type_contexte_loi_stat_station":1,"type_loi_station":2,"code_sandre_reseau_station":["POH001","POH044","POH122","POH905","RIC062","RIC312"],"date_debut_ref_alti_station":"2006-08-30T00:00:00Z","date_activation_ref_alti_station":"2013-11-18T00:00:00Z","date_maj_ref_alti_station":"2020-12-14T00:00:00Z","libelle_departement":"HAUT-RHIN","en_service":true,"geometry":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:OGC:1.3:CRS84"}},"coordinates":[7.230914946754491,48.15490751430966]}},{"code_site":"A2120200","libelle_site":"La Weiss à Kaysersberg","code_station":"A212020002","libelle_station":"La Weiss à Kaysersberg - Fréland-Gare [Ancienne]","type_station":"STD","coordonnee_x_station":1013309.0,"coordonnee_y_station":6792394.0,"code_projection":26,"longitude_station":7.215457142,"latitude_station":48.156623648,"influence_locale_station":1,"commentaire_station":"Station arrêtée en janvier 2007, dans le cadre du programme R.HY.AL, suite à la mise en service en août 2006 de la station de Kaysersberg Rapperie (A2120200) située plus en aval.","altitude_ref_alti_station":318.0,"code_systeme_alti_site":2,"code_commune_station":"68162","libelle_commune":"KAYSERSBERG VIGNOBLE","code_departement":"68","code_region":"44","libelle_region":"GRAND EST","code_cours_e