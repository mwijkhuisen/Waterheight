oordonnee_y_station":6883731.0,"code_projection":26,"longitude_station":7.757499063,"latitude_station":48.959105711,"influence_locale_station":1,"commentaire_station":"Mise en service d'un limnigraphe le 08/12/1966. Antérieurement, échelle limnimétrique seule, avec un seul relevé (lecture) par jour. Arrêt des mesures le 10/01/2001, puis remise en service le 14/10/2021 09:52. Données hauteurs issues d'un radar à ultra son (Ijinus) du 14/10/2021 au 30/08/2023. Station télétransmise avec capteur radar depuis le 31/08/2023. Nivellement de l'origine de l'échelle limnimétrique en NGF-IGN69 le 30/07/2024 par le cabinet géomètre un point six. Le complément de libellé (Liebfrauenthal) a été ôté en 2026 pour simplification des noms de site/station.","altitude_ref_alti_station":171.0,"code_systeme_alti_site":2,"code_commune_station":"67160","libelle_commune":"GŒRSDORF","code_departement":"67","code_region":"44","libelle_region":"GRAND EST","code_cours_eau":"A3--0110","libelle_cours_eau":"La Sauer","uri_cours_eau":"http://id.eaufrance.fr/CEA/A3--0110","descriptif_station":null,"date_maj_station":"2026-03-23T00:00:00Z","date_ouverture_station":"1948-01-22T00:00:00Z","date_fermeture_station":null,"commentaire_influence_locale_station":null,"code_regime_station":1,"qualification_donnees_station":20,"code_finalite_station":"1 2","type_contexte_loi_stat_station":1,"type_loi_station":2,"code_sandre_reseau_station":["POH001","POH044","POH122","POH905","RIC062","RIC312"],"date_debut_ref_alti_station":"1948-01-22T00:00:00Z","date_activation_ref_alti_station":"2024-01-08T00:00:00Z","date_maj_ref_alti_station":"2024-05-02T00:00:00Z","libelle_departement":"BAS-RHIN","en_service":true,"geometry":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:OGC:1.3:CRS84"}},"coordinates":[7.757499063488773,48.95910571146236]}},{"code_site":"A3680210","libelle_site":"L'Eberbach à Leutenheim","code_station":"A368021001","libelle_station":"L'Eberbach à Leutenheim","type_station":"STD","coordonnee_x_station":1067284.0,"coordonnee_y_station":6871730.0,"code_projection":26,"longitude_station":8.007495391,"latitude_station":48.84077133,"influence_locale_station":1,"commentaire_station":"Nivellement du zéro de l'échelle limnimétrique établi le 23 juillet 2002 par le géomètre P.A Baur à Haguenau. Depuis le 26/10/2009, les horaires de cette station sont exprimés en temps universel (TU). Des travaux de renaturation de bras morts réalisés en oct-nov 2019 (SDEA) ont eu pour conséquence un contournement partiel des écoulements en moyennes et hautes eaux. Ce contournement n'a été observé qu'en Juin 2025. Les débits publiés entre fin 2019 et mi 2025 sont pas conséquent incertains par sous estimation.","altitude_ref_alti_station":115.465,"code_systeme_alti_site":3,"code_commune_station":"67264","libelle_commune":"LEUTENHEIM","code_departement":"67","code_region":"44","libelle_region":"GRAND EST","code_cours_eau":"A36-0210","libelle_cours_eau":"Ruisseau l'Eberbach","uri_cours_eau":"http://id.eaufrance.fr/CEA/A36-0210","descriptif_station":null,"date_maj_station":"2026-03-23T00:00:00Z","date_ouverture_station":"2002-09-11T00:00:00Z","date_fermeture_station":null,"commentaire_influence_locale_station":null,"code_regime_station":1,"qualification_donnees_station":20,"code_finalite_station":null,"type_contexte_loi_stat_station":1,"type_loi_station":2,"code_sandre_reseau_station":["POH001","POH044","POH122","POH905","RIC062","RIC312"],"date_debut_ref_alti_station":"2002-09-11T00:00:00Z","date_activation_ref_alti_station":"2023-02-08T00:00:00Z","date_maj_ref_alti_station":"2024-07-11T00:00:00Z","libelle_departement":"BAS-RHIN","en_service":true,"geometry":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:OGC:1.3:CRS84"}},"coordinates":[8.007495390823493,48.84077132953929]}},{"code_site":"A3690110","libelle_site":"La Sauer à Beinheim","code_station":"A369011001","libelle_station":"La Sauer à Beinheim - Forêt","type_station":"STD","coordonne