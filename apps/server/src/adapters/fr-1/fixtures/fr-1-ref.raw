54784593]}},{"code_site":"A7821010","libelle_site":"La Seille à Nomeny","code_station":"A782101001","libelle_station":"La Seille à Nomeny","type_station":"STD","coordonnee_x_station":936609.0,"coordonnee_y_station":6870186.0,"code_projection":26,"longitude_station":6.227562537,"latitude_station":48.888160213,"influence_locale_station":1,"commentaire_station":"Depuis le 23/03/2007, les horaires sont en TU. Depuis le 05/07/2023, les capteurs ont été déplacés quelques dizaines de mètre à l'aval et fixés sur le pont suite à des travaux de renaturation de la rivière qui ont nécessité l'enlèvement des capteurs immergés.  La nouvelle échelle fixée sur le pont a été nivelée sur l'ancienne, le 0 de l'échelle en altitude NGF est donc inchangé.","altitude_ref_alti_station":180.66,"code_systeme_alti_site":3,"code_commune_station":"54400","libelle_commune":"NOMENY","code_departement":"54","code_region":"44","libelle_region":"GRAND EST","code_cours_eau":"A7--0100","libelle_cours_eau":"La Seille","uri_cours_eau":"http://id.eaufrance.fr/CEA/A7--0100","descriptif_station":null,"date_maj_station":"2023-12-01T00:00:00Z","date_ouverture_station":"1968-09-01T00:00:00Z","date_fermeture_station":null,"commentaire_influence_locale_station":null,"code_regime_station":1,"qualification_donnees_station":20,"code_finalite_station":"1 2","type_contexte_loi_stat_station":1,"type_loi_station":2,"code_sandre_reseau_station":["POH014","POH123","RIC011","BSH006","BSH054","RIC110","RIC060","RIC260","RIC310","POH042","POH905"],"date_debut_ref_alti_station":"1968-09-01T00:00:00Z","date_activation_ref_alti_station":"2013-11-18T00:00:00Z","date_maj_ref_alti_station":"2023-08-04T00:00:00Z","libelle_departement":"MEURTHE-ET-MOSELLE","en_service":true,"geometry":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:OGC:1.3:CRS84"}},"coordinates":[6.227562537018656,48.88816021287249]}},{"code_site":"A7864310","libelle_site":"Le ruisseau de Cherisey à Verny","code_station":"A786431001","li