TD","coordonnee_x_station":1034778.0,"coordonnee_y_station":6804633.0,"code_projection":26,"longitude_station":7.513108901,"latitude_station":48.255909219,"influence_locale_station":2,"commentaire_station":"Etude RIED Centre Alsace. Station fermée le 05/02/2019. Une analyse des stations du Ried a été conduite en 2018 menant à redéfinir le réseau. La station de Baldenheim a été fermée car de qualité moyenne sur les débits annoncés et pas située sur le secteur le plus intéressant pour évaluer les échanges nappes-rivières.  Les débits publiés à Baldenheim ont une incertitude de +- 25%. Les hauteurs enregistrées à la station de Baldenheim sont cependant correctes.","altitude_ref_alti_station":null,"code_systeme_alti_site":null,"code_commune_station":"67019","libelle_commune":"BALDENHEIM","code_departement":"67","code_region":"44","libelle_region":"GRAND EST","code_cours_eau":"A22-0200","libelle_cours_eau":"Ruisseau la Blind","uri_cours_eau":"http://id.eaufrance.fr/CEA/A22-0200","descriptif_station":null,"date_maj_station":"2022-01-18T00:00:00Z","date_ouverture_station":"2004-03-17T00:00:00Z","date_fermeture_station":"2019-02-05T00:00:00Z","commentaire_influence_locale_station":"Herbiers.","code_regime_station":1,"qualification_donnees_station":12,"code_finalite_station":"6 7","type_contexte_loi_stat_station":1,"type_loi_station":2,"code_sandre_reseau_station":["POH001","POH044","POH122","POH905"],"date_debut_ref_alti_station":null,"date_activation_ref_alti_station":null,"date_maj_ref_alti_station":null,"libelle_departement":"BAS-RHIN","en_service":false,"geometry":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:OGC:1.3:CRS84"}},"coordinates":[7.513108900609352,48.25590921904268]}},{"code_site":"A2260201","libelle_site":"Le ruisseau la Blind à Ohnenheim","code_station":"A226020101","libelle_station":"Le ruisseau la Blind à Ohnenheim","type_station":"STD","coordonnee_x_station":1033570.0,"coordonnee_y_station":6797130.0,"code_projection":26,"lon