és depuis 1994. Echelle limnimétrique située sous le pont de la rue du 25 janvier.","altitude_ref_alti_station":0.17361000000000001,"code_systeme_alti_site":3,"code_commune_station":"68153","libelle_commune":"ILLHAEUSERN","code_departement":"68","code_region":"44","libelle_region":"GRAND EST","code_cours_eau":"A---0030","libelle_cours_eau":"L'Ill","uri_cours_eau":"http://id.eaufrance.fr/CEA/A---0030","descriptif_station":null,"date_maj_station":"2026-03-23T00:00:00Z","date_ouverture_station":"2022-11-24T00:00:00Z","date_fermeture_station":null,"commentaire_influence_locale_station":null,"code_regime_station":1,"qualification_donnees_station":16,"code_finalite_station":"7","type_contexte_loi_stat_station":null,"type_loi_station":null,"code_sandre_reseau_station":["POH001","POH044","POH122","POH905","RIC062","RIC312"],"date_debut_ref_alti_station":"2022-11-15T00:00:00Z","date_activation_ref_alti_station":"2022-11-21T00:00:00Z","date_maj_ref_alti_station":"2023-03-28T00:00:00Z","libelle_departement":"HAUT-RHIN","en_service":true,"geometry":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:OGC:1.3:CRS84"}},"coordinates":[7.432607296259953,48.18466641022804]}},{"code_site":"A2220001","libelle_site":"Le ruisseau le Riedbrunnen à Colmar [Ried]","code_station":"A222000101","libelle_station":"Le ruisseau le Riedbrunnen à Colmar [Ried]","type_station":"STD","coordonnee_x_station":1030580.0,"coordonnee_y_station":6793902.0,"code_projection":26,"longitude_station":7.448495474,"latitude_station":48.161650916,"influence_locale_station":0,"commentaire_station":"Etude RIED Centre Alsace.  Nivellement du 0 de l'échelle réalisé par l'équipe d'hydrométrie (2023).","altitude_ref_alti_station":175.24,"code_systeme_alti_site":3,"code_commune_station":"68066","libelle_commune":"COLMAR","code_departement":"68","code_region":"44","libelle_region":"GRAND EST","code_cours_eau":"A2220660","libelle_cours_eau":"Ruisseau le Riedbrunnen","uri_cours_eau":"http://id.eaufranc