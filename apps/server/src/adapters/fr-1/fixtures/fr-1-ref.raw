 la hauteur sur la même section que le bulle à bulle.","altitude_ref_alti_station":163.37,"code_systeme_alti_site":3,"code_commune_station":"57463","libelle_commune":"METZ","code_departement":"57","code_region":"44","libelle_region":"GRAND EST","code_cours_eau":"A7--0100","libelle_cours_eau":"La Seille","uri_cours_eau":"http://id.eaufrance.fr/CEA/A7--0100","descriptif_station":"Pont Lothaire aval","date_maj_station":"2021-02-17T00:00:00Z","date_ouverture_station":"1964-10-01T00:00:00Z","date_fermeture_station":"2016-12-31T00:00:00Z","commentaire_influence_locale_station":null,"code_regime_station":1,"qualification_donnees_station":20,"code_finalite_station":"1 2","type_contexte_loi_stat_station":1,"type_loi_station":2,"code_sandre_reseau_station":["POH014","POH042","POH123","POH905"],"date_debut_ref_alti_station":"1964-10-01T00:00:00Z","date_activation_ref_alti_station":"2013-11-18T00:00:00Z","date_maj_ref_alti_station":"2016-01-08T00:00:00Z","libelle_departement":"MOSELLE","en_service":false,"geometry":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:OGC:1.3:CRS84"}},"coordinates":[6.188151566531442,49.10077426212024]}},{"code_site":"A7881010","libelle_site":"La Seille à Metz","code_station":"A788101002","libelle_station":"La Seille à Metz - Pont Lothaire amont","type_station":"STD","coordonnee_x_station":932770.0,"coordonnee_y_station":6893662.0,"code_projection":26,"longitude_station":6.188174925,"latitude_station":49.100485691,"influence_locale_station":0,"commentaire_station":"2 radars sur potence amont pont Lothaire + nouvelle échelle. Station commune avec Metz agglomération (données mises à disposition par la DREAL). Implantée suite à reconstruction du pont Lothaire (été 2015) zéro échelle à 163,527m","altitude_ref_alti_station":163.54,"code_systeme_alti_site":3,"code_commune_station":"57463","libelle_commune":"METZ","code_departement":"57","code_region":"44","libelle_region":"GRAND EST","code_cours_eau":"A7--0100","libelle_cours_eau