t_ref_alti_station":"1972-04-28T00:00:00Z","date_activation_ref_alti_station":"2013-11-18T00:00:00Z","date_maj_ref_alti_station":"2020-12-14T00:00:00Z","libelle_departement":"HAUT-RHIN","en_service":true,"geometry":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:OGC:1.3:CRS84"}},"coordinates":[7.369707586473915,48.15971272572328]}},{"code_site":"A2140101","libelle_site":"La Fecht à Bennwihr","code_station":"A214010101","libelle_station":"La Fecht à Bennwihr - ancienne","type_station":"STD","coordonnee_x_station":1023708.0,"coordonnee_y_station":6790372.0,"code_projection":26,"longitude_station":7.353594479,"latitude_station":48.133381148,"influence_locale_station":1,"commentaire_station":null,"altitude_ref_alti_station":183.0,"code_systeme_alti_site":2,"code_commune_station":"68026","libelle_commune":"BENNWIHR","code_departement":"68","code_region":"44","libelle_region":"GRAND EST","code_cours_eau":"A2--0100","libelle_cours_eau":"La Fecht","uri_cours_eau":"http://id.eaufrance.fr/CEA/A2--0100","descriptif_station":"ancienne","date_maj_station":"2026-03-23T00:00:00Z","date_ouverture_station":"1957-10-01T00:00:00Z","date_fermeture_station":"1971-01-01T00:00:00Z","commentaire_influence_locale_station":null,"code_regime_station":1,"qualification_donnees_station":20,"code_finalite_station":"1 2","type_contexte_loi_stat_station":1,"type_loi_station":2,"code_sandre_reseau_station":null,"date_debut_ref_alti_station":"1957-10-01T00:00:00Z","date_activation_ref_alti_station":"2013-11-18T00:00:00Z","date_maj_ref_alti_station":"2019-12-03T00:00:00Z","libelle_departement":"HAUT-RHIN","en_service":false,"geometry":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:OGC:1.3:CRS84"}},"coordinates":[7.353594479023897,48.133381147914044]}},{"code_site":"A2140101","libelle_site":"La Fecht à Bennwihr","code_station":"A214010102","libelle_station":"La Fecht à Bennwihr","type_station":"STD","coordonnee_x_station":1023669.0,"coordonnee_y_station":6790317.0,"code_projection":26,"longitude_station":7.353030288,"latitude_station":48.13290633,"influence_locale_station":1,"commentaire_station":"Suite aux contournement de la station d'Ostheim en crue du fait de la vanne en amont du village (présente depuis 1991), une nouvelle station est installée sur le site de Bennwihr le 25/11/2019. Une nouvelle échelle est posée. L'échelle est calée sur l'ancienne échelle présente sur la pile centrale du pont. Ouvrage sous la route en rive gauche à 140m du pont (actif en crue). Modification du nom de la station en 2026 : Bennwihr au lieu de Bennwihr Gare","altitude_ref_alti_station":null,"code_systeme_alti_site":null,"code_commune_station":"68026","libelle_commune":"BENNWIHR","code_departement":"68","code_region":"44","libelle_region":"GRAND EST","code_cours_eau":"A2--0100","libelle_cours_eau":"La Fecht","uri_cours_eau":"http://id.eaufrance.fr/CEA/A2--0100","descriptif_station":null,"date_maj_station":"2026-03-23T00:00:00Z","date_ouverture_station":"2019-11-26T00:00:00Z","date_fermeture_station":null,"commentaire_influence_locale_station":"Présence d'un ouvrage laissant passer l'eau en crue sous la route en rive gauche, à 140 m du pont. A jauger en crue.","code_regime_station":1,"qualification_donnees_station":20,"code_finalite_station":"1 2 3","type_contexte_loi_stat_station":null,"type_loi_station":null,"code_sandre_reseau_station":["POH001","POH044","POH122","POH905","RIC062","RIC312"],"date_debut_ref_alti_station":null,"date_activation_ref_alti_station":null,"date_maj_ref_alti_station":null,"libelle_departement":"HAUT-RHIN","en_service":true,"geometry":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:OGC:1.3:CRS84"}},"coordinates":[7.353030287735831,48.13290632963429]}},{"code_site":"A2150300","libelle_site":"Le ruisseau le Strengbach à Ribeauvillé","code_station":"A215030001","libelle_station":"Le ruisseau le Strengbach à Ribeauvillé","type_station":"STD","coordonnee_x_station":1019413.47,