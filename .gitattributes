# The vendored map assets are checked byte for byte against SHA256SUMS and the
# registry pin (test/basemap-style.test.ts): never convert their line endings.
apps/web/public/assets/map/** -text
# The vendored brand fonts and their OFL texts, likewise against apps/web/src/styles/fonts/SHA256SUMS (P10c).
apps/web/src/styles/fonts/** -text
tools/geo/fixtures/*.pmtiles binary
# Adapter fixtures are payloads as recorded (CRLF in DE-7 and DE-8, ZIPs): their bytes, and the sha256 of a cut, must
# never change with a checkout (P5b).
apps/server/src/adapters/*/fixtures/*.raw -text
tools/geo/fixtures/*.pbf binary
tools/geo/fixtures/*.opl -text
tools/geo/fixtures/*.geojsonseq -text
