# Example environment for local development. Never put a real secret here or in
# any committed file (invariant 6); production secrets are Compose file secrets
# under /etc/rws/secrets/ (A§3), mounted at /run/secrets/.

# api role: listen address (defaults 127.0.0.1:8080)
HOST=127.0.0.1
PORT=8080

# capture role (the P1a ↔ P1b contract, issue #16). Without RWS_DOMAIN and
# RWS_CONTACT_EMAIL the capture role refuses to start (exit 78): no request
# leaves without a contact User-Agent. File secrets, never env vars:
# /run/secrets/hc_ping_key and /run/secrets/rws_x_api_key.
RWS_RAW_DIR=/data/raw
RWS_STATUS_DIR=/data/status
RWS_OWNER_STATUS_DIR=/data/owner-status
RWS_DOMAIN=
RWS_CONTACT_EMAIL=

# test:integration: a local PostgreSQL 18 with the builtin C.UTF-8 locale
# (the SessionStart hook starts one on port 5433 with trust auth on localhost).
DATABASE_URL=postgres://rws@localhost:5433/rws
