# Copy to .env and adjust. Every value here has a working default in
# packages/server/src/config.ts.
#
# This file is read from the repository root, found relative to the application
# rather than the shell's working directory -- so `npm run migrate` and the
# CLIs pick it up wherever you run them from. Set ENV_FILE to use a different
# path (the systemd unit does). Real environment variables always win over this
# file, so a unit's Environment= or a compose environment block still takes
# precedence.
#
# It holds a database password once filled in: chmod 640 it.

# --- Server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database ---
# PostgreSQL with TimescaleDB. docker-compose brings this up on 5432 with the
# timescale/timescaledb image; a native install listens on the same port (see
# docs/INSTALL-UBUNTU.md). A MariaDB/MySQL on the same machine is unaffected --
# it uses 3306.
DATABASE_URL=postgres://rws:rws@localhost:5432/rws
DB_POOL_SIZE=10

# Used only by the integration tests, which create and drop a throwaway
# database of their own -- so this role needs CREATEDB. Point it at any
# TimescaleDB-enabled instance. Leave it unreachable and the whole integration
# suite skips itself, which makes `npm test` pass without proving anything.
TEST_DATABASE_URL=postgres://rws:rws@localhost:5432/postgres

# --- Rijkswaterstaat upstream ---
# The classic waterwebservices.rijkswaterstaat.nl hosts were shut down at the
# end of April 2026; this is the WADAR (ddapi20) replacement.
RWS_API_BASE=https://ddapi20-waterwebservices.rijkswaterstaat.nl
RWS_WFS_URL=https://geo.rijkswaterstaat.nl/services/ogc/hws/DDAPI20/ows

# Not required today, but Rijkswaterstaat asks clients to send a key so that
# future key-based rate limiting does not break them.
RWS_API_KEY=dummy

RWS_TIMEOUT_MS=120000
# Politeness cap on concurrent outbound calls.
RWS_MAX_CONCURRENCY=4
RWS_MAX_RETRIES=5

# --- Behaviour ---
# A location counts as active if its latest observation is newer than this.
ACTIVE_WINDOW_DAYS=7

# RWS publishes on a ~10-minute cadence.
CACHE_LATEST_TTL_SECONDS=300
CACHE_OBSERVATIONS_TTL_SECONDS=180

# Cap on points returned for one chart request.
MAX_POINTS_PER_RESPONSE=2000

# --- Proxies ---
# Node's fetch ignores HTTPS_PROXY unless this is set. Only needed if your
# network requires an outbound proxy.
# NODE_USE_ENV_PROXY=1

# --- Backfill ---
# Quantities backfilled lazily instead of eagerly. Comma-separated; an empty
# value means "defer nothing", i.e. a full eager backfill.
# BACKFILL_DEFERRED=STROOMRTG,STROOMSHD,ECHO

# Run the daily refresh, weekly correction re-fetch and five-minute latest
# poll inside the API process. Enable on exactly one instance.
ENABLE_SCHEDULES=false

# --- Latest poll ---
# Pulls the newest reading of every live series on a fixed cadence, so live
# data is served from the store instead of being fetched from Rijkswaterstaat
# while a visitor waits. Needs ENABLE_SCHEDULES=true to run in the API; the
# `latest` CLI runs the same cycle by hand or with --watch.
ENABLE_LATEST_POLL=true
LATEST_POLL_INTERVAL_MINUTES=5

# How old a reading may be and still count as live. This decides both which
# series are polled and which returned readings are stored -- the endpoint
# answers with every series a location ever ran, some last heard from in 1900.
LATEST_POLL_MAX_AGE_HOURS=48

# Locations one filter is asked for in a single call, and the ceiling on the
# location x filter cross product a call may ask for. The second is the lever
# between calls and bytes: measured over 1,744 live series, a cap that packs
# one filter per call cost 140 calls and 4.5 MiB, the default 8 calls and
# 6.6 MiB, both returning the same readings.
LATEST_POLL_BATCH_SIZE=100
LATEST_POLL_MAX_COMBINATIONS=2000

# Pairs probed per cycle for a series the poll does not know yet: a cold store,
# a station back from maintenance, a swapped instrument. Oldest first, so
# everything gets its turn without a burst of calls upstream.
LATEST_POLL_DISCOVERY_LIMIT=50
LATEST_POLL_DISCOVERY_HOURS=26

# Whether a request for a window the store does not cover may fetch it from
# Rijkswaterstaat while the caller waits. On by default, which is what makes a
# fresh install useful before any backfill has run. Turn it off once the poll
# and the backfill keep the store current and every upstream call should come
# from the scheduler rather than from visitor traffic.
LIVE_FETCH_ON_REQUEST=true

# --- Map client ---
# Read by Vite when the client is BUILT, not by the server at runtime: it is
# baked into the bundle, so changing it means `npm run build:web` again rather
# than a restart. Docker takes it as a build argument
# (`docker build --build-arg BASEMAP_STYLE_URL=...`).
#
# The default is OpenFreeMap's `positron`, OpenStreetMap vector tiles served
# without a key. Point it at a self-hosted style -- a Protomaps `.pmtiles`
# behind a tile server, say -- to drop the third-party dependency; it must be a
# v8 style document and its glyph endpoint must serve `Noto Sans Bold`, which is
# what the cluster counts are labelled in.
# VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# --- Production serving ---
# Directory of the built map client. Set in the Docker image so the API serves
# the whole app on one origin. Leave empty to run an API-only instance.
# Docker:
# WEB_ROOT=/app/packages/web/dist
# Native install, as an absolute path to the built client:
# WEB_ROOT=/opt/rws/packages/web/dist

# Allowed CORS origin for third-party API consumers. The bundled client is
# same-origin and does not need this. The data is public and the API read-only,
# so '*' is a reasonable default; set an origin to lock it down.
CORS_ORIGIN=*

# Inbound rate limit per IP. /api/health is always exempt.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# --- docker compose ---
# Required: compose refuses to start without it, so no known credential ships.
POSTGRES_PASSWORD=
# Host port for the API (the app is served here too).
API_PORT=3000
