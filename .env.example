# Example environment for local development. Never put a real secret here or in
# any committed file (invariant 6); production secrets are Compose file secrets
# under /etc/rws/secrets/ (A§3).

# api role: listen address (defaults 127.0.0.1:8080)
HOST=127.0.0.1
PORT=8080

# test:integration: a local PostgreSQL 18 with the builtin C.UTF-8 locale
# (the SessionStart hook starts one on port 5433 with trust auth on localhost).
DATABASE_URL=postgres://rws@localhost:5433/rws
